{
  "name": "@mandate/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "node --watch --env-file-if-exists=../../.env --import ./scripts/resolve-ts.ts src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import ./scripts/resolve-ts.ts src/server.ts",
    "db:migrate": "node --env-file-if-exists=../../.env --import ./scripts/resolve-ts.ts scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=../../.env --import ./scripts/resolve-ts.ts scripts/db.ts seed"
  },
  "dependencies": {
    "@mandate/payments": "workspace:*",
    "@mandate/policy": "workspace:*",
    "@mandate/shared": "workspace:*",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/pg": "8.23.1"
  }
}
