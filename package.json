{
  "name": "mandate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mandate/api dev",
    "dev:web": "pnpm --filter @mandate/web dev",
    "db:migrate": "pnpm --filter @mandate/api db:migrate",
    "db:seed": "pnpm --filter @mandate/api db:seed",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "pnpm --filter @mandate/evals eval",
    "smoke:offline": "pnpm -r --if-present smoke:offline",
    "smoke:live": "pnpm -r --if-present smoke:live"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
