# Placeholders only. Never commit real values; .env is git-ignored.

# LLM layer (packages/llm). Read only by loadLlmConfig().
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=8192

# Payments (packages/payments). Sandbox app credentials from developer.paypal.com > Apps & Credentials.
# Read only by loadPaypalConfig(). The client is sandbox-only; there is no live setting.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_MS=20000
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel
# Id of the webhook registered on the sandbox app (Apps & Credentials > app > Webhooks). Optional; without it
# POST /webhooks/paypal is not served, because signatures cannot be verified.
PAYPAL_WEBHOOK_ID=

# API (apps/api). Read only by loadApiConfig(). Render sets PORT itself; set HOST=0.0.0.0 there.
# production turns on the fail-closed checks (DATABASE_URL required, owner credentials refused, restricted login
# enforced); render.yaml sets it. Locally leave it unset (development).
# NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# Browser origins allowed to call the API (comma-separated). The Vite dev server runs on 5173.
WEB_ORIGIN=http://localhost:5173

# Approvals through Zapier (docs/zapier.md). Both or neither. The hook URL is a secret: anyone holding it can post to the Zap.
ZAPIER_APPROVAL_WEBHOOK_URL=
WEB_APP_URL=http://localhost:5173
# Postgres. Matches docker-compose.yml (if you changed POSTGRES_PORT there, change the port here too).
# The API's runtime login. Locally the compose superuser is fine (findings are warnings outside production).
# On Render: the INTERNAL URL with the restricted login from `pnpm db:roles` (docs/deployment-render.md).
DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5432/mandate
# Operator commands (pnpm db:migrate, db:status, db:roles, db:seed) connect with MIGRATION_DATABASE_URL, the
# database OWNER's URL, or locally with DATABASE_URL when it is unset. Outside NODE_ENV=production they refuse any
# non-local database. For Render, load the owner's URL into your SHELL only (read -rs; docs/deployment-render.md),
# never into this file, and never on the API service.
# pnpm db:roles only: the API login's name (default mandate_app) and its password (16-256 printable ASCII, no
# spaces), e.g. from: openssl rand -base64 33 | tr -d '\n/+='   Never set these on the API service.
# MANDATE_APP_DB_USER=mandate_app
# MANDATE_APP_DB_PASSWORD=
# pnpm db:seed with NODE_ENV=production writes demo data only when this is 1.
# MANDATE_SEED_DEMO=
# Emergency only: start the API in production with a privileged database login (logged at every start).
# MANDATE_DB_ALLOW_PRIVILEGED_RUNTIME=0
# Integration tests only. This database is WIPED on every run; never point it at real data.
# TEST_DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5432/mandate_test
