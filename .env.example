# Placeholders only. Never commit real values; .env is git-ignored.

# LLM layer (packages/llm). Read only by loadLlmConfig().
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=8192

# Payments (packages/payments). Sandbox app credentials from developer.paypal.com > Apps & Credentials.
# Read only by loadPaypalConfig(). The client is sandbox-only; there is no live setting.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_MS=20000
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel

# API (apps/api). Read only by loadApiConfig(). Render sets PORT itself; set HOST=0.0.0.0 there.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Database (packages/db). Read by loadDatabaseConfig() and by docker-compose.yml.
# Local defaults only; they match docker-compose.yml, so this block can stay commented out on a laptop.
# Change POSTGRES_PORT if 5432 is taken by another Postgres. In a deployment set DATABASE_URL instead
# (it wins over the POSTGRES_* variables) and use a real password.
# Runtime (the API): DATABASE_URL. Administration (db:migrate, db:seed, db:roles): DATABASE_ADMIN_URL, falling
# back to DATABASE_URL. In a deployment DATABASE_URL is the least-privilege login role created by `pnpm db:roles`,
# and DATABASE_ADMIN_URL the owner. The API must never hold the owner credentials.
# With NODE_ENV=production the API needs DATABASE_URL and must not be given DATABASE_ADMIN_URL; db:* scripts need
# DATABASE_ADMIN_URL; the two must be different users; the POSTGRES_* defaults below are never used.
# DATABASE_URL=
# DATABASE_ADMIN_URL=
# Superuser, for `pnpm db:harden` only (large-object creation, migration 0007). Never give it to the API.
# DATABASE_SUPERUSER_URL=
# POSTGRES_USER=mandate
# POSTGRES_PASSWORD=mandate
# POSTGRES_DB=mandate
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# ELASTICSEARCH_PORT=9200
# Login role for the API, created by `pnpm db:roles` (member of mandate_runtime only). 16-256 printable ASCII.
# MANDATE_APP_DB_USER=mandate_app
# MANDATE_APP_DB_PASSWORD=
